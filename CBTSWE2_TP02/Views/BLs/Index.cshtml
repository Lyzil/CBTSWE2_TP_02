@model IEnumerable<CBTSWE2_TP02.Models.BL>

@{
    ViewData["Title"] = "BLs";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">BLs</h1>

    <a asp-action="Create" class="btn btn-primary">
        Cadastrar BL
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.Numero)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Consignee)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Navio)
                        </th>
                        <th>Ações</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Numero)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Consignee)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Navio)
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.ID"
                                       class="btn btn-primary btn-sm">
                                        Editar
                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@item.ID"
                                       class="btn btn-info btn-sm">
                                        Detalhes
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.ID"
                                       class="btn btn-danger btn-sm">
                                        Excluir
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>