@model CBTSWE2_TP02.Models.ContainerOBJ

@{
    ViewData["Title"] = "Excluir Contêiner";
}

<h1 class="mb-4">Excluir Contêiner</h1>

<div class="alert alert-warning">
    <strong>Atenção!</strong> Tem certeza de que deseja excluir este contêiner?
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <h4 class="card-title">Dados do Contêiner</h4>
        <hr />

        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Numero)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Numero)
            </dd>

            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Tipo)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Tipo)
            </dd>

            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Tamanho)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Tamanho)
            </dd>

            <dt class="col-sm-2">
                BL
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Bl.Consignee)
            </dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="ID" />

            <div class="d-flex gap-2">
                <input type="submit" value="Excluir" class="btn btn-danger" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>