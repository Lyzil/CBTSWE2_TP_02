@model CBTSWE2_TP02.Models.ContainerOBJ

@{
    ViewData["Title"] = "Detalhes do Contêiner";
}

<h1 class="mb-4">Detalhes do Contêiner</h1>

<div class="card shadow-sm">
    <div class="card-body">
        <h4 class="card-title">Contêiner</h4>
        <hr />

        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Numero)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Numero)
            </dd>

            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Tipo)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Tipo)
            </dd>

            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Tamanho)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Tamanho)
            </dd>

            <dt class="col-sm-2">
                BL
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Bl.Consignee)
            </dd>
        </dl>

        <div class="d-flex gap-2">
            <a asp-action="Edit"
               asp-route-id="@Model?.ID"
               class="btn btn-primary">
                Editar
            </a>

            <a asp-action="Index" class="btn btn-secondary">
                Voltar à lista
            </a>
        </div>
    </div>
</div>